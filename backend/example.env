PROVIDER=openai
API_KEY=paste_your_key_here           # fallback upstream key (optional)
OPENAI_API_KEY=                       # preferred OpenAI key
ANTHROPIC_API_KEY=                       # preferred Claude/Anthropic key
OPENAI_PROVIDER_URL=https://api.openai.com/v1
ANTHROPIC_PROVIDER_URL=https://api.anthropic.com
PORT=8080
LOG_LEVEL=info

# Database (optional; when set, enables persistent API keys)
# For Supabase, use the project Postgres connection string.
# Example: postgres://postgres:postgres@db.abc.supabase.co:5432/postgres
DATABASE_URL=

# Encryption key for provider BYOK (32 bytes base64 or raw string)
ENCRYPTION_KEY=

# Google OAuth (for Supabase Auth social login)
# Create OAuth credentials in Google Cloud Console and set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only: seed one gateway API key into in-memory store
# When DATABASE_URL is empty, you can set a dev key here to test:
#   Authorization: Bearer <GATEWAY_DEV_KEY>
GATEWAY_DEV_KEY=sk_dev_example_123


